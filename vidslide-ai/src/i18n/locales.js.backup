// 默认语言
export const defaultLocale = 'zh-CN'

// 获取当前语言
export function getCurrentLocale() {
  return localStorage.getItem('vidslide-locale') || defaultLocale
}

// 设置语言
export function setLocale(locale) {
  if (locales[locale]) {
    localStorage.setItem('vidslide-locale', locale)
    return true
  }
  return false
}

// 获取翻译文本
export function t(key, locale = null) {
  const currentLocale = locale || getCurrentLocale()
  const keys = key.split('.')
  let value = locales[currentLocale]
  
  for (const k of keys) {
    if (value && value[k]) {
      value = value[k]
    } else {
      // 如果找不到翻译，回退到默认语言
      value = locales[defaultLocale]
      for (const k2 of keys) {
        if (value && value[k2]) {
          value = value[k2]
        } else {
          return key
        }
      }
      break
    }
  }
  
  return value || key
}
