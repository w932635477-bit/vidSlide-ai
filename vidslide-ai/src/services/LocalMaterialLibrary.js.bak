      '战略': `<path d="M12 2l10 6v8l-10 6L2 16V8l10-6zM12 6l6 3.5L12 13l-6-3.5L12 6z"/><circle cx="12" cy="12" r="2"/><path d="M8 8l8 8m0-8l-8 8"/>`,
      '创新': `<path d="M12 2l8 8H4l8-8z"/><circle cx="12" cy="14" r="6"/><circle cx="12" cy="14" r="3"/><path d="M6 8l12 12m-12 0l12-12"/>`,
      '服务': `<path d="M12 2c-5 0-9 4-9 9 0 3 2 6 5 7l2 1v2h4v-2l2-1c3-1 5-4 5-7 0-5-4-9-9-9zm-2 8c0-.5.5-1 1-1s1 .5 1 1-.5 1-1 1-1-.5-1-1zm4 0c0-.5.5-1 1-1s1 .5 1 1-.5 1-1 1-1-.5-1-1z"/><circle cx="12" cy="12" r="1"/>`
    }

    const path = iconMap[iconName] || `<circle cx="12" cy="12" r="8"/><path d="M8 12l2 2 4-4"/>`
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`

    return `data:image/svg+xml;base64,${btoa(svg)}`
  }

  /**
   * 生成中文教育元素SVG
   */
  generateChineseEducationDataUrl(elementName) {
    const elementMap = {
      '知识树': `<path d="M12 2l8 6v8l-8 6-8-6V8l8-6z"/><circle cx="12" cy="8" r="2"/><circle cx="8" cy="12" r="2"/><circle cx="16" cy="12" r="2"/><circle cx="10" cy="16" r="2"/><circle cx="14" cy="16" r="2"/>`,
      '智慧灯': `<path d="M12 2l4 8h-8l4-8z"/><rect x="8" y="10" width="8" height="12" rx="4"/><circle cx="12" cy="18" r="2"/><path d="M6 10l2 4m12-4l-2 4"/>`,
      '书本': `<path d="M4 4h16v16H4V4zm2 2v12h12V6H6zm2 2h8v2H8V8zm0 4h6v2H8v-2zm0 4h4v2H8v-2z"/>`,
      '证书': `<rect x="4" y="6" width="16" height="12" rx="2"/><path d="M8 10h8m-8 3h6"/><circle cx="16" cy="14" r="3"/><path d="M14 14l2 2 4-4"/>`,
      '奖杯': `<path d="M8 2l8 6v4c0 2-1 4-4 4s-4-2-4-4V8L8 2z"/><rect x="6" y="12" width="12" height="2"/><rect x="8" y="14" width="8" height="8" rx="4"/>`
    }

    const path = elementMap[elementName] || `<circle cx="12" cy="12" r="8"/><path d="M8 12l2 2 4-4"/>`
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`

    return `data:image/svg+xml;base64,${btoa(svg)}`
  }

  /**
   * 生成图标素材
   */
  generateIconMaterials() {
    const materials = []
    const iconSets = {
      feather: {
        subcategory: '科技',
        industry: '科技',
        semanticTags: ['科技', '界面', '导航'],
        icons: [
          { name: 'home', tags: ['主页', '导航', '首页'], concepts: ['导航', '界面'] },
          { name: 'user', tags: ['用户', '个人', '账户'], concepts: ['用户', '个人'] },
          { name: 'settings', tags: ['设置', '配置', '选项'], concepts: ['配置', '管理'] },
          { name: 'search', tags: ['搜索', '查找', '查询'], concepts: ['搜索', '发现'] },
          { name: 'heart', tags: ['喜欢', '收藏', '喜爱'], concepts: ['情感', '偏好'] },
          { name: 'star', tags: ['收藏', '重要', '精选'], concepts: ['重要', '优质'] },
          { name: 'check', tags: ['完成', '正确', '确认'], concepts: ['完成', '成功'] },
          { name: 'x', tags: ['关闭', '删除', '取消'], concepts: ['关闭', '移除'] },
          { name: 'plus', tags: ['添加', '新增', '创建'], concepts: ['创建', '增加'] },
          { name: 'minus', tags: ['减少', '删除', '移除'], concepts: ['减少', '删除'] }
        ]
      },
      hero: {
        subcategory: '教育',
        industry: '教育',
        semanticTags: ['教育', '学习', '知识'],
        icons: [
          { name: 'academic-cap', tags: ['学历', '学位', '教育'], concepts: ['教育', '学位'] },
          { name: 'adjustments', tags: ['调整', '设置', '配置'], concepts: ['配置', '优化'] },
          { name: 'annotation', tags: ['注释', '笔记', '标记'], concepts: ['学习', '记录'] },
          { name: 'archive', tags: ['存档', '存储', '历史'], concepts: ['存储', '历史'] },
          { name: 'arrow-circle-down', tags: ['下载', '向下', '获取'], concepts: ['下载', '获取'] }
        ]
      },
      lucide: {
        subcategory: '商业',
        industry: '商业',
        semanticTags: ['商业', '效率', '管理'],
        icons: [
          { name: 'activity', tags: ['活动', '动态', '监控'], concepts: ['监控', '活动'] },
          { name: 'airplay', tags: ['投屏', '展示', '演示'], concepts: ['演示', '展示'] },
          { name: 'alarm-clock', tags: ['提醒', '时间', '闹钟'], concepts: ['时间', '提醒'] },
          { name: 'align-center', tags: ['居中', '对齐', '布局'], concepts: ['布局', '设计'] },
          { name: 'align-justify', tags: ['两端对齐', '格式', '排版'], concepts: ['排版', '格式'] }
        ]
      }
    }

    Object.entries(iconSets).forEach(([library, config]) => {
      config.icons.forEach(icon => {
        materials.push({
          id: `icon-${library}-${icon.name}`,
          category: 'icons',
          subcategory: config.subcategory,
          industry: config.industry,
          scene: '通用',
          style: '简约',
          name: icon.name,
          type: 'svg',
          tags: [...icon.tags, library],
          keywords: [...icon.tags, '图标', library],
          semanticTags: config.semanticTags,
          relatedConcepts: icon.concepts,
          contextKeywords: [...icon.tags, ...icon.concepts],
          dataUrl: this.generateIconDataUrl(icon.name, library),
          thumbnailUrl: this.generateIconDataUrl(icon.name, library),
          dimensions: { width: 24, height: 24 },
          usageCount: 0,
          lastUsed: null,
          createdAt: Date.now()
        })
      })
    })

    return materials
  }

