  /**
   * 打开IndexedDB数据库
   */
  async openDatabase() {
    return new Promise((resolve, reject) => {
      const request = indexedDB.open(this.dbName, this.dbVersion)

      request.onerror = () => reject(request.error)
      request.onsuccess = () => {
        this.db = request.result
        resolve()
      }

      request.onupgradeneeded = event => {
        const db = event.target.result
        const oldVersion = event.oldVersion

        // 素材存储 - 扩展字段支持八维体系
        if (!db.objectStoreNames.contains('materials')) {
          const materialStore = db.createObjectStore('materials', { keyPath: 'id' })

          // 基础索引
          materialStore.createIndex('category', 'category', { unique: false })
          materialStore.createIndex('subcategory', 'subcategory', { unique: false })
          materialStore.createIndex('tags', 'tags', { unique: false, multiEntry: true })
          materialStore.createIndex('usageCount', 'usageCount', { unique: false })

          // 新增语义索引 (v3)
          materialStore.createIndex('industry', 'industry', { unique: false })
          materialStore.createIndex('scene', 'scene', { unique: false })
          materialStore.createIndex('style', 'style', { unique: false })
          materialStore.createIndex('semanticTags', 'semanticTags', { unique: false, multiEntry: true })
          materialStore.createIndex('relatedConcepts', 'relatedConcepts', { unique: false, multiEntry: true })
          materialStore.createIndex('contextKeywords', 'contextKeywords', { unique: false, multiEntry: true })
        }

        // 搜索索引存储
        if (!db.objectStoreNames.contains('searchIndex')) {
          const indexStore = db.createObjectStore('searchIndex', { keyPath: 'term' })
          indexStore.createIndex('materials', 'materialIds', { unique: false, multiEntry: true })
        }

        // 语义索引存储 (v3)
        if (!db.objectStoreNames.contains('semanticIndex')) {
          const semanticStore = db.createObjectStore('semanticIndex', { keyPath: 'concept' })
          semanticStore.createIndex('materials', 'materialIds', { unique: false, multiEntry: true })
        }

        // 元数据存储
        if (!db.objectStoreNames.contains('metadata')) {
          db.createObjectStore('metadata', { keyPath: 'key' })
        }

        // 用户偏好存储 (v3)
        if (!db.objectStoreNames.contains('userPreferences')) {
          db.createObjectStore('userPreferences', { keyPath: 'key' })
        }

        // 外部素材缓存存储 (v4 - 智能缓存管理)
        if (!db.objectStoreNames.contains('externalCache')) {
          const cacheStore = db.createObjectStore('externalCache', { keyPath: 'id' })

          // 缓存管理索引
          cacheStore.createIndex('source', 'source', { unique: false }) // 平台来源
          cacheStore.createIndex('lastAccess', 'lastAccess', { unique: false }) // 最后访问时间
          cacheStore.createIndex('usageCount', 'usageCount', { unique: false }) // 使用次数
          cacheStore.createIndex('size', 'size', { unique: false }) // 素材大小
          cacheStore.createIndex('priority', 'priority', { unique: false }) // 缓存优先级
        }

        // 缓存元数据存储 (v4)
        if (!db.objectStoreNames.contains('cacheMetadata')) {
          db.createObjectStore('cacheMetadata', { keyPath: 'key' })
        }

        console.log(`📦 数据库升级完成: v${oldVersion} → v${this.dbVersion}`)
      }
    })
  }

  /**
   * 加载所有素材
   */
  async loadMaterials() {
    const materials = await this.getAllMaterials()

    if (materials.length === 0) {
      // 首次运行，加载预置素材
      await this.loadPresetMaterials()
    } else {
      // 加载现有素材到内存
      materials.forEach(material => {
        this.materials.set(material.id, material)
      })
    }

    console.log(`📚 已加载 ${this.materials.size} 个本地素材`)
  }

  /**
   * 加载预置素材数据
   */
  async loadPresetMaterials() {
    const presetMaterials = this.generatePresetMaterials()
    const batchSize = 50

    for (let i = 0; i < presetMaterials.length; i += batchSize) {
      const batch = presetMaterials.slice(i, i + batchSize)
      await this.addMaterialsBatch(batch)
    }

    console.log(`✨ 已加载 ${presetMaterials.length} 个预置素材`)
  }

  /**
   * 生成预置素材数据 - 八维分类体系（国内用户优化版）
   * 针对视频制作的实际需求，优先包含高频使用的素材
   */
  generatePresetMaterials() {
    const materials = []

    // 1. 图标素材 (基础包 - 400个，增加中文商务图标)
    const iconMaterials = this.generateIconMaterials()
    materials.push(...iconMaterials)

    // 2. 图表素材 (基础包 - 250个，增加数据可视化图表)
    const chartMaterials = this.generateChartMaterials()
    materials.push(...chartMaterials)

    // 3. 教育素材 (基础包 - 300个，增加课件常用元素)
    const educationMaterials = this.generateEducationMaterials()
    materials.push(...educationMaterials)

    // 4. 科技素材 (增强包 - 250个，增加AI、科技相关)
    const techMaterials = this.generateTechMaterials()
    materials.push(...techMaterials)

    // 5. 商业素材 (增强包 - 200个，增加中文商务元素)
    const businessMaterials = this.generateBusinessMaterials()
    materials.push(...businessMaterials)

    // 6. 背景素材 (增强包 - 200个，增加视频背景模板)
    const backgroundMaterials = this.generateBackgroundMaterials()
    materials.push(...backgroundMaterials)

    // 7. 生活素材 (专业包 - 200个，增加生活场景)
    const lifestyleMaterials = this.generateLifestyleMaterials()
    materials.push(...lifestyleMaterials)

    // 8. 装饰素材 (专业包 - 150个，增加视频装饰元素)
    const decorativeMaterials = this.generateDecorativeMaterials()
    materials.push(...decorativeMaterials)

    // 9. 国内特色素材 (新增 - 100个，专门针对国内用户)
    const chineseMaterials = this.generateChineseMaterials()
    materials.push(...chineseMaterials)

    console.log(`📦 生成预置素材: ${materials.length} 个 (覆盖9大分类，国内用户优化)`)
    return materials
  }

