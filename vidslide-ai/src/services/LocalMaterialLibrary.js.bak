  /**
   * 构建同义词词典
   */
  buildSynonymDictionary() {
    return {
      // 商业关键词
      增长: ['上涨', '增加', '提升', '发展', '进步'],
      销售: ['营销', '推广', '市场', '客户', '业绩'],
      利润: ['收益', '收入', '回报', '盈利', '获利'],
      成本: ['费用', '开支', '支出', '花费'],

      // 科技关键词
      创新: ['创造', '突破', '变革', '技术', '研发'],
      数字: ['数字化', '在线', '网络', '互联网', '智能'],
      效率: ['效能', '生产力', '优化', '改进', '提升'],
      数据: ['信息', '资料', '统计', '分析'],

      // 教育关键词
      学习: ['教育', '培训', '知识', '技能', '能力'],
      学生: ['学员', '学者', '学习者', '受教育者'],
      教师: ['老师', '导师', '教员', '教育工作者'],
      课程: ['科目', '学科', '教程', '教学内容'],

      // 生活关键词
      健康: ['保健', '养生', '医疗', '疾病', '治疗'],
      运动: ['体育', '健身', '锻炼', '活动'],
      美食: ['食物', '菜肴', '烹饪', '饮食'],
      旅行: ['旅游', '出行', '度假', '出游'],

      // 通用关键词
      好: ['优秀', '优质', '良好', '出色', '卓越'],
      快: ['快速', '迅速', '高效', '敏捷', '即时'],
      多: ['众多', '大量', '丰富', '充足'],
      新: ['最新', '新型', '创新', '现代'],

      // 形状关键词
      圆形: ['圆圈', '圆', '球形', '环形'],
      方形: ['正方形', '矩形', '四边形', '方块'],
      三角形: ['三角', '三边形'],
      星形: ['星星', '星号', '五角星'],

      // 颜色关键词
      红色: ['红', '朱红', '鲜红', '大红'],
      蓝色: ['蓝', '湛蓝', '天蓝', '深蓝'],
      绿色: ['绿', '翠绿', '墨绿', '浅绿'],
      黄色: ['黄', '金黄', '明黄', '淡黄'],
      黑色: ['黑', '乌黑', '深黑'],
      白色: ['白', '雪白', '纯白']
    }
  }

  /**
   * 扩展关键词
   */
  expandKeywords(keywords) {
    const expanded = new Set()

    keywords.forEach(keyword => {
      // 添加原始关键词
      expanded.add(keyword.toLowerCase())

      // 添加同义词
      const synonyms = this.synonymDictionary[keyword] || []
      synonyms.forEach(synonym => expanded.add(synonym.toLowerCase()))

      // 添加部分匹配
      if (keyword.length > 2) {
        Object.entries(this.synonymDictionary).forEach(([key, values]) => {
          if (key.includes(keyword) || keyword.includes(key)) {
            expanded.add(key.toLowerCase())
            values.forEach(value => expanded.add(value.toLowerCase()))
          }
        })
      }
    })

    return Array.from(expanded)
  }

  /**
   * 构建所有索引 (倒排索引 + 语义索引)
   */
  async buildIndexes() {
    // 构建倒排索引
    await this.buildInvertedIndex()

    // 构建语义索引
    await this.buildSemanticIndex()

    console.log(`🔍 已构建完整索引体系 - 倒排索引: ${this.invertedIndex.size}词, 语义索引: ${this.semanticIndex.size}概念`)
  }

  /**
   * 构建倒排索引
   */
  async buildInvertedIndex() {
    this.invertedIndex.clear()
    this.materialTerms.clear()

    for (const [id, material] of this.materials) {
      const terms = await this.extractTerms(material)
      this.materialTerms.set(id, terms)

      terms.forEach(term => {
        if (!this.invertedIndex.has(term)) {
          this.invertedIndex.set(term, [])
        }

        const score = this.calculateRelevanceScore(term, material)
        this.invertedIndex.get(term).push([id, score])
      })
    }

    // 排序优化查询性能
    for (const [term, entries] of this.invertedIndex) {
      entries.sort((a, b) => b[1] - a[1]) // 按评分降序
    }

    console.log(`🔍 倒排索引构建完成，包含 ${this.invertedIndex.size} 个搜索词`)
  }

  /**
   * 构建语义索引
   */
  async buildSemanticIndex() {
    this.semanticIndex.clear()

    for (const [id, material] of this.materials) {
      const semanticTerms = this.extractSemanticTerms(material)

      semanticTerms.forEach(({ concept, score }) => {
        if (!this.semanticIndex.has(concept)) {
          this.semanticIndex.set(concept, [])
        }

        this.semanticIndex.get(concept).push([id, score])
      })
    }

    // 排序优化查询性能
    for (const [concept, entries] of this.semanticIndex) {
      entries.sort((a, b) => b[1] - a[1]) // 按评分降序
    }

    console.log(`🧠 语义索引构建完成，包含 ${this.semanticIndex.size} 个语义概念`)
  }

  /**
   * 提取素材的搜索词
   */
  async extractTerms(material) {
    const terms = new Set()

    // 添加基本信息
    ;[material.name, material.category, material.subcategory].filter(Boolean).forEach(text => {
      text.split(/[\s\-_]/).forEach(word => {
        if (word.length > 1) terms.add(word.toLowerCase())
      })
    })

    // 添加标签
    material.tags?.forEach(tag => {
      tag.split(/[\s\-_]/).forEach(word => {
        if (word.length > 1) terms.add(word.toLowerCase())
      })
    })

    // 添加关键词
    material.keywords?.forEach(keyword => {
      keyword.split(/[\s\-_]/).forEach(word => {
        if (word.length > 1) terms.add(word.toLowerCase())
      })
    })

    // 添加新语义字段 (v3)
    material.semanticTags?.forEach(tag => {
      tag.split(/[\s\-_]/).forEach(word => {
        if (word.length > 1) terms.add(word.toLowerCase())
      })
    })

    material.relatedConcepts?.forEach(concept => {
      concept.split(/[\s\-_]/).forEach(word => {
        if (word.length > 1) terms.add(word.toLowerCase())
      })
    })

    return Array.from(terms)
  }

  /**
   * 提取语义概念
   */
  extractSemanticTerms(material) {
    const semanticTerms = []

    // 基于行业和场景的语义匹配
    if (material.industry) {
      const industryConcepts = this.getIndustryConcepts(material.industry)
      industryConcepts.forEach(concept => {
        semanticTerms.push({
          concept,
          score: 0.8 // 行业相关度高
        })
      })
    }

    if (material.scene) {
      const sceneConcepts = this.getSceneConcepts(material.scene)
      sceneConcepts.forEach(concept => {
        semanticTerms.push({
          concept,
          score: 0.7 // 场景相关度中等
        })
      })
    }

    // 基于语义标签的精确匹配
    material.semanticTags?.forEach(tag => {
      semanticTerms.push({
        concept: tag,
        score: 0.9 // 语义标签精确匹配
      })

      // 添加相关概念
      const related = this.semanticDictionary[tag] || []
      related.forEach(relatedConcept => {
        semanticTerms.push({
          concept: relatedConcept,
          score: 0.6 // 相关概念匹配度较低
        })
      })
    })

    return semanticTerms
  }

  /**
   * 获取行业相关概念
   */
  getIndustryConcepts(industry) {
    const industryMap = {
      教育: ['教学', '学习', '知识', '学生', '教师', '课程'],
      科技: ['创新', '数字化', 'AI', '编程', '互联网', '技术'],
      商业: ['市场', '销售', '管理', '金融', '服务', '客户'],
      医疗: ['健康', '治疗', '医生', '病人', '药物'],
      金融: ['投资', '理财', '银行', '资金', '收益']
    }
    return industryMap[industry] || []
  }

  /**
   * 获取场景相关概念
   */
  getSceneConcepts(scene) {
    const sceneMap = {
      会议: ['讨论', '汇报', '演示', '协作', '团队'],
      演讲: ['展示', '表达', '沟通', '宣讲', '报告'],
      教学: ['讲解', '学习', '知识', '互动', '练习'],
      营销: ['推广', '品牌', '销售', '广告', '客户'],
      报告: ['数据', '分析', '总结', '展示', '决策']
    }
    return sceneMap[scene] || []
  }

  /**
   * 计算相关度评分
   */
  calculateRelevanceScore(term, material) {
    let score = 0

    // 名称匹配 (最高权重)
    if (material.name?.toLowerCase().includes(term)) {
      score += 1.0
    }

    // 关键词匹配
    if (material.keywords?.some(k => k.toLowerCase().includes(term))) {
      score += 0.8
    }

    // 标签匹配
    if (material.tags?.some(t => t.toLowerCase().includes(term))) {
      score += 0.6
    }

    // 分类匹配
    if (
      material.category?.toLowerCase().includes(term) ||
      material.subcategory?.toLowerCase().includes(term)
    ) {
      score += 0.4
    }

    // 使用频率加成
    if (material.usageCount > 0) {
      score += Math.min(material.usageCount / 100, 0.2)
    }

    // 最近使用加成
    if (material.lastUsed) {
      const daysSinceUsed = (Date.now() - material.lastUsed) / (1000 * 60 * 60 * 24)
      if (daysSinceUsed < 7) {
        score += 0.1
      } else if (daysSinceUsed < 30) {
        score += 0.05
      }
    }

    return score
  }

  /**
   * 智能搜索素材 - 四层匹配策略
   */
  async searchMaterials(query, options = {}) {
    const {
      limit = 20,
      minScore = 0.1,
      category = null,
      context = {},
      useSemantic = true
    } = options

    if (!query || query.trim().length === 0) {
      return { materials: [], totalCount: 0, fromCache: false }
    }

    // 检查缓存
    const cacheKey = `${query}-${category}-${JSON.stringify(context)}`
    if (this.searchCache.has(cacheKey)) {
      return { ...this.searchCache.get(cacheKey), fromCache: true }
    }

    // 扩展关键词
    const keywords = query.split(/[\s,，]+/).filter(k => k.length > 0)
    const expandedKeywords = this.expandKeywords(keywords)

    console.log(`🔍 智能搜索: "${query}" -> 扩展关键词: [${expandedKeywords.join(', ')}]`)

    // 第一层：精确匹配
    const exactMatches = await this.exactMatch(expandedKeywords, category)

    // 第二层：语义扩展匹配
    const semanticMatches = useSemantic ?
      await this.semanticMatch(expandedKeywords, context) : new Map()

    // 第三层：上下文推断匹配
    const contextMatches = await this.contextInference(context)

    // 第四层：智能推荐
    const recommendations = await this.smartRecommendation(query, context)

    // 合并和排序结果
    const allMatches = this.mergeMatchResults([
      { matches: exactMatches, weight: 1.0 },
      { matches: semanticMatches, weight: 0.8 },
      { matches: contextMatches, weight: 0.6 },
      { matches: recommendations, weight: 0.4 }
    ])

    // 转换为结果数组
    const results = Array.from(allMatches.entries())
      .filter(([, score]) => score >= minScore)
      .sort((a, b) => b[1] - a[1])
      .slice(0, limit)
      .map(([id, score]) => ({
        ...this.materials.get(id),
        relevanceScore: score,
        matchReason: this.getMatchReason(id, expandedKeywords),
        matchLayer: this.getMatchLayer(id, exactMatches, semanticMatches, contextMatches, recommendations)
      }))

    const result = {
      materials: results,
      totalCount: results.length,
      expandedKeywords,
      matchStats: {
        exact: exactMatches.size,
        semantic: semanticMatches.size,
        context: contextMatches.size,
        recommended: recommendations.size
      },
      fromCache: false
    }

    // 缓存结果
    this.searchCache.set(cacheKey, result)

    console.log(`📊 四层匹配完成: ${results.length} 个结果 (精确:${exactMatches.size}, 语义:${semanticMatches.size}, 上下文:${contextMatches.size}, 推荐:${recommendations.size})`)

    return result
  }

  /**
   * 第一层：精确匹配
   */
  async exactMatch(keywords, category = null) {
    const materialScores = new Map()

    for (const keyword of keywords) {
      if (!this.invertedIndex.has(keyword)) continue

      const entries = this.invertedIndex.get(keyword)
      for (const [materialId, score] of entries) {
        if (category && this.materials.get(materialId)?.category !== category) {
          continue
        }

        const currentScore = materialScores.get(materialId) || 0
        materialScores.set(materialId, currentScore + score)
      }
    }

    return materialScores
  }

  /**
   * 第二层：语义扩展匹配
   */
  async semanticMatch(keywords, context = {}) {
    const materialScores = new Map()

    // 基于语义词典扩展
    const semanticKeywords = new Set()
    keywords.forEach(keyword => {
      semanticKeywords.add(keyword)
      const synonyms = this.semanticDictionary[keyword] || []
      synonyms.forEach(synonym => semanticKeywords.add(synonym))
    })

    // 搜索语义索引
    for (const keyword of semanticKeywords) {
      if (!this.semanticIndex.has(keyword)) continue

      const entries = this.semanticIndex.get(keyword)
      for (const [materialId, score] of entries) {
        const currentScore = materialScores.get(materialId) || 0
        materialScores.set(materialId, currentScore + score * 0.8) // 语义匹配权重稍低
      }
    }

    // 基于上下文的语义匹配
    if (context.industry) {
      const industryConcepts = this.getIndustryConcepts(context.industry)
      industryConcepts.forEach(concept => {
        if (this.semanticIndex.has(concept)) {
          const entries = this.semanticIndex.get(concept)
          entries.forEach(([materialId, score]) => {
            const currentScore = materialScores.get(materialId) || 0
            materialScores.set(materialId, currentScore + score * 0.6)
          })
        }
      })
    }

    return materialScores
  }

  /**
   * 第三层：上下文推断匹配
   */
  async contextInference(context = {}) {
    const materialScores = new Map()

    // 基于使用历史推断
    if (context.recentMaterials) {
      context.recentMaterials.forEach(materialId => {
        const material = this.materials.get(materialId)
        if (material) {
          // 推荐相似分类的素材
          const similarMaterials = this.findSimilarMaterials(material, 5)
          similarMaterials.forEach(similarId => {
            const currentScore = materialScores.get(similarId) || 0
            materialScores.set(similarId, currentScore + 0.3)
          })
        }
      })
    }

    // 基于场景推断
    if (context.scene) {
      for (const [id, material] of this.materials) {
        if (material.scene === context.scene) {
          const currentScore = materialScores.get(id) || 0
          materialScores.set(id, currentScore + 0.4)
        }
      }
    }

    return materialScores
  }

  /**
   * 第四层：智能推荐
   */
  async smartRecommendation(query, context = {}) {
    const materialScores = new Map()

    // 1. 基于用户偏好推荐
    this.addPreferenceBasedScores(materialScores)

    // 2. 基于使用历史推荐
    this.addUsageBasedScores(materialScores)

    // 3. 基于热门素材推荐
    this.addPopularityBasedScores(materialScores)

    // 4. 基于上下文的协同推荐
    this.addContextBasedScores(materialScores, context)

    return materialScores
  }

  /**
   * 添加偏好基础评分
   */
  addPreferenceBasedScores(materialScores) {
    if (this.userProfile.favoriteCategories) {
      this.userProfile.favoriteCategories.forEach(category => {
        for (const [id, material] of this.materials) {
          if (material.category === category) {
            const currentScore = materialScores.get(id) || 0
            materialScores.set(id, currentScore + 0.2)
          }
        }
      })
    }

    // 行业偏好加成
    if (this.userProfile.industryPreferences) {
      const topIndustries = Object.entries(this.userProfile.industryPreferences)
        .sort(([, a], [, b]) => b.successRate - a.successRate)
        .slice(0, 2)
        .map(([industry]) => industry)

      topIndustries.forEach(industry => {
        for (const [id, material] of this.materials) {
          if (material.industry === industry) {
            const currentScore = materialScores.get(id) || 0
            materialScores.set(id, currentScore + 0.15)
          }
        }
      })
    }

    // 风格偏好加成
    if (this.userProfile.stylePreferences) {
      const topStyle = Object.entries(this.userProfile.stylePreferences)
        .sort(([, a], [, b]) => b - a)[0]?.[0]

      if (topStyle) {
        for (const [id, material] of this.materials) {
          if (material.style === topStyle) {
            const currentScore = materialScores.get(id) || 0
            materialScores.set(id, currentScore + 0.1)
          }
        }
      }
    }
  }

  /**
   * 添加使用历史基础评分
   */
  addUsageBasedScores(materialScores) {
    // 最近使用的素材加成
    const recentMaterials = Array.from(this.materials.values())
      .filter(m => m.lastUsed)
      .sort((a, b) => b.lastUsed - a.lastUsed)
      .slice(0, 5)

    recentMaterials.forEach((material, index) => {
      const score = 0.15 * (1 - index * 0.1) // 最近的权重更高
      const currentScore = materialScores.get(material.id) || 0
      materialScores.set(material.id, currentScore + score)
    })
  }

  /**
   * 添加热门度基础评分
   */
  addPopularityBasedScores(materialScores) {
    // 基于使用频率的热门推荐
    const popularMaterials = Array.from(this.materials.values())
      .filter(m => (m.usageCount || 0) > 0)
      .sort((a, b) => (b.usageCount || 0) - (a.usageCount || 0))
      .slice(0, 10)

    popularMaterials.forEach((material, index) => {
      const score = 0.1 * (1 - index * 0.05) // 更热门的权重更高
      const currentScore = materialScores.get(material.id) || 0
      materialScores.set(material.id, currentScore + score)
    })
  }

  /**
   * 添加上下文基础评分
   */
  addContextBasedScores(materialScores, context = {}) {
    // 基于时间上下文的推荐
    const hour = new Date().getHours()
    let timeContext = 'general'

    if (hour >= 9 && hour <= 12) timeContext = 'morning_work'
    else if (hour >= 12 && hour <= 14) timeContext = 'lunch_break'
    else if (hour >= 14 && hour <= 18) timeContext = 'afternoon_work'
    else if (hour >= 18 && hour <= 22) timeContext = 'evening'
    else timeContext = 'night'

    // 根据时间推荐不同类型的素材
    const timeBasedCategories = {
      morning_work: ['charts', 'business'], // 工作开始，推荐数据图表
      lunch_break: ['decorative', 'backgrounds'], // 休息时间，推荐装饰素材
      afternoon_work: ['tech', 'education'], // 工作中期，推荐专业素材
      evening: ['lifestyle'], // 晚上，推荐生活化素材
      night: ['decorative'] // 深夜，推荐轻松素材
    }

    const relevantCategories = timeBasedCategories[timeContext] || []
    relevantCategories.forEach(category => {
      for (const [id, material] of this.materials) {
        if (material.category === category) {
          const currentScore = materialScores.get(id) || 0
          materialScores.set(id, currentScore + 0.05)
        }
      }
    })
  }

  /**
   * 合并匹配结果
   */
  mergeMatchResults(matchSources) {
    const finalScores = new Map()

    matchSources.forEach(({ matches, weight }) => {
      for (const [materialId, score] of matches) {
        const currentScore = finalScores.get(materialId) || 0
        finalScores.set(materialId, currentScore + score * weight)
      }
    })

    return finalScores
  }

  /**
   * 查找相似素材
   */
  findSimilarMaterials(material, limit = 5) {
    const similar = []

    for (const [id, otherMaterial] of this.materials) {
      if (id === material.id) continue

      let similarity = 0

      // 分类相似度
      if (otherMaterial.category === material.category) similarity += 0.4
      if (otherMaterial.subcategory === material.subcategory) similarity += 0.3

      // 行业相似度
      if (otherMaterial.industry === material.industry) similarity += 0.2

      // 标签相似度
      const tagOverlap = this.calculateTagOverlap(material.tags || [], otherMaterial.tags || [])
      similarity += tagOverlap * 0.1

      if (similarity > 0.3) { // 相似度阈值
        similar.push({ id, similarity })
      }
    }

    return similar
      .sort((a, b) => b.similarity - a.similarity)
      .slice(0, limit)
      .map(item => item.id)
  }

  /**
   * 计算标签重叠度
   */
  calculateTagOverlap(tags1, tags2) {
    const set1 = new Set(tags1)
    const set2 = new Set(tags2)
    const intersection = new Set([...set1].filter(x => set2.has(x)))
    const union = new Set([...set1, ...set2])
    return intersection.size / union.size
  }

  /**
   * 获取匹配层级
   */
  getMatchLayer(materialId, exactMatches, semanticMatches, contextMatches, recommendations) {
    if (exactMatches.has(materialId)) return 'exact'
    if (semanticMatches.has(materialId)) return 'semantic'
    if (contextMatches.has(materialId)) return 'context'
    if (recommendations.has(materialId)) return 'recommended'
    return 'unknown'
  }

  /**
   * 获取匹配原因
   */
  getMatchReason(materialId, keywords) {
    const material = this.materials.get(materialId)
    if (!material) return '未知'

    const reasons = []

    keywords.forEach(keyword => {
      if (material.name?.toLowerCase().includes(keyword)) {
        reasons.push(`名称匹配: ${material.name}`)
      }
      if (material.keywords?.some(k => k.toLowerCase().includes(keyword))) {
        reasons.push(`关键词匹配: ${keyword}`)
      }
      if (material.tags?.some(t => t.toLowerCase().includes(keyword))) {
        reasons.push(`标签匹配: ${keyword}`)
      }
    })

    return reasons.length > 0 ? reasons[0] : '扩展匹配'
  }

  /**
   * 记录素材使用
   */
  async recordUsage(materialId) {
    const material = this.materials.get(materialId)
    if (!material) return

    material.usageCount++
    material.lastUsed = Date.now()

    await this.updateMaterial(material)
  }

  /**
   * 获取热门素材
   */
  async getPopularMaterials(limit = 10) {
    const materials = Array.from(this.materials.values())
      .filter(m => m.usageCount > 0)
      .sort((a, b) => b.usageCount - a.usageCount)
      .slice(0, limit)

    return materials
  }

  /**
   * 获取最近使用的素材
   */
  async getRecentMaterials(limit = 10) {
    const materials = Array.from(this.materials.values())
      .filter(m => m.lastUsed)
      .sort((a, b) => b.lastUsed - a.lastUsed)
      .slice(0, limit)

    return materials
  }

  /**
   * 获取统计信息
   */
  async getStatistics() {
    const stats = {
      totalMaterials: this.materials.size,
      categoryBreakdown: {},
      industryBreakdown: {},
      usageStats: {
        totalUsage: 0,
        mostUsed: null,
        recentlyUsed: null
      },
      searchStats: {
        invertedIndexTerms: this.invertedIndex.size,
        semanticIndexConcepts: this.semanticIndex.size,
        avgTermsPerMaterial: 0,
        avgConceptsPerMaterial: 0
      },
      userProfile: this.userProfile
    }

    // 分类和行业统计
    for (const material of this.materials.values()) {
      // 分类统计
      const category = material.category
      stats.categoryBreakdown[category] = (stats.categoryBreakdown[category] || 0) + 1

      // 行业统计
      const industry = material.industry || '未分类'
      stats.industryBreakdown[industry] = (stats.industryBreakdown[industry] || 0) + 1

      // 使用统计
      stats.usageStats.totalUsage += material.usageCount || 0

      if (
        !stats.usageStats.mostUsed ||
        material.usageCount > stats.usageStats.mostUsed.usageCount
      ) {
        stats.usageStats.mostUsed = material
      }

      if (
        !stats.usageStats.recentlyUsed ||
        (material.lastUsed &&
          (!stats.usageStats.recentlyUsed.lastUsed ||
            material.lastUsed > stats.usageStats.recentlyUsed.lastUsed))
      ) {
        stats.usageStats.recentlyUsed = material
      }
    }

    // 搜索索引统计
    if (this.materials.size > 0) {
      const totalTerms = Array.from(this.materialTerms.values()).reduce(
        (sum, terms) => sum + terms.length,
        0
      )
      stats.searchStats.avgTermsPerMaterial = totalTerms / this.materials.size

      const totalConcepts = Array.from(this.materials.values()).reduce(
        (sum, material) => sum + (material.semanticTags?.length || 0) + (material.relatedConcepts?.length || 0),
        0
      )
      stats.searchStats.avgConceptsPerMaterial = totalConcepts / this.materials.size
    }

    return stats
  }

  /**
   * 加载用户偏好
   */
  async loadUserPreferences() {
    try {
      const preferences = await this.getFromStore('userPreferences', 'profile')
      if (preferences) {
        this.userProfile = { ...this.userProfile, ...preferences }
      }
    } catch (error) {
      console.warn('加载用户偏好失败:', error)
    }
  }

  /**
   * 保存用户偏好
   */
  async saveUserPreferences() {
    try {
      await this.saveToStore('userPreferences', 'profile', this.userProfile)
    } catch (error) {
      console.error('保存用户偏好失败:', error)
    }
  }

  /**
   * 更新用户偏好
   */
  async updateUserPreference(key, value) {
    this.userProfile[key] = value
    await this.saveUserPreferences()

    // 如果是分类偏好，重新计算推荐权重
    if (key === 'favoriteCategories') {
      await this.rebuildIndexes()
    }
  }

  /**
   * 加载用户画像
   */
  loadUserProfile() {
    return {
      favoriteCategories: [],
      preferredStyles: [],
      industryFocus: null,
      usagePatterns: {},
      lastSearchQueries: [],
      searchHistory: []
    }
  }

  /**
   * 记录搜索行为
   */
  async recordSearchBehavior(query, results) {
    // 更新搜索历史
    this.userProfile.searchHistory.unshift({
      query,
      timestamp: Date.now(),
      resultCount: results.length,
      matchLayers: results.map(r => r.matchLayer).filter(Boolean)
    })

    // 保持最近20个搜索用于分析
    if (this.userProfile.searchHistory.length > 20) {
      this.userProfile.searchHistory = this.userProfile.searchHistory.slice(0, 20)
    }

    // 更新使用模式和偏好学习
    await this.learnFromSearch(query, results)

    await this.saveUserPreferences()
  }

  /**
   * 从搜索行为中学习
   */
  async learnFromSearch(query, results) {
    const keywords = query.split(/[\s,，]+/).filter(k => k.length > 0)

    // 更新关键词使用频率
    keywords.forEach(keyword => {
      this.usagePatterns.set(keyword, (this.usagePatterns.get(keyword) || 0) + 1)
    })

    // 分析搜索意图
    const searchIntent = this.analyzeSearchIntent(query, results)

    // 更新领域偏好
    if (searchIntent.industry) {
      this.updateIndustryPreference(searchIntent.industry, results.length > 0)
    }

    // 更新场景偏好
    if (searchIntent.scene) {
      this.updateScenePreference(searchIntent.scene, results.length > 0)
    }

    // 更新风格偏好
    if (searchIntent.style) {
      this.updateStylePreference(searchIntent.style)
    }

    // 分析匹配质量，反馈学习
    this.analyzeMatchQuality(results)
  }

  /**
   * 分析搜索意图
   */
  analyzeSearchIntent(query, results) {
    const keywords = query.split(/[\s,，]+/).filter(k => k.length > 0)
    const intent = {
      industry: null,
      scene: null,
      style: null,
      complexity: 'simple'
    }

    // 检测行业关键词
    const industryKeywords = {
      教育: ['教学', '学习', '学生', '教师', '课程', '考试'],
      科技: ['技术', '创新', '数字', 'AI', '编程', '数据'],
      商业: ['市场', '销售', '管理', '客户', '企业', '利润'],
      医疗: ['健康', '治疗', '医生', '病人', '医院'],
      金融: ['投资', '理财', '银行', '资金', '收益']
    }

    for (const [industry, words] of Object.entries(industryKeywords)) {
      if (keywords.some(k => words.some(w => k.includes(w) || w.includes(k)))) {
        intent.industry = industry
        break
      }
    }

    // 检测场景关键词
    const sceneKeywords = {
      会议: ['会议', '汇报', '演示', '讨论', '团队'],
      演讲: ['演讲', '宣讲', '报告', '展示', '表达'],
      教学: ['教学', '讲解', '课堂', '培训', '教育'],
      营销: ['营销', '推广', '广告', '品牌', '销售'],
      报告: ['报告', '数据', '分析', '总结', '决策']
    }

    for (const [scene, words] of Object.entries(sceneKeywords)) {
      if (keywords.some(k => words.some(w => k.includes(w)))) {
        intent.scene = scene
        break
      }
    }

    // 检测风格偏好
    const styleKeywords = {
      简约: ['简单', '简洁', '干净', '清晰'],
      现代: ['现代', '时尚', '潮流', '新颖'],
      古典: ['古典', '传统', '优雅', '复古'],
      卡通: ['卡通', '可爱', '动漫', '活泼'],
      写实: ['写实', '真实', '专业', '精细']
    }

    for (const [style, words] of Object.entries(styleKeywords)) {
      if (keywords.some(k => words.some(w => k.includes(w)))) {
        intent.style = style
        break
      }
    }

    // 判断查询复杂度
    if (keywords.length > 3 || query.includes('和') || query.includes('与')) {
      intent.complexity = 'complex'
    }

    return intent
  }

  /**
   * 更新行业偏好
   */
  updateIndustryPreference(industry, successful) {
    if (!this.userProfile.industryPreferences) {
      this.userProfile.industryPreferences = {}
    }

    const current = this.userProfile.industryPreferences[industry] || { count: 0, successRate: 0 }
    current.count++

    if (successful) {
      current.successCount = (current.successCount || 0) + 1
    }

    current.successRate = current.successCount / current.count
    this.userProfile.industryPreferences[industry] = current
  }

  /**
   * 更新场景偏好
   */
  updateScenePreference(scene, successful) {
    if (!this.userProfile.scenePreferences) {
      this.userProfile.scenePreferences = {}
    }

    const current = this.userProfile.scenePreferences[scene] || { count: 0, successRate: 0 }
    current.count++

    if (successful) {
      current.successCount = (current.successCount || 0) + 1
    }

    current.successRate = current.successCount / current.count
    this.userProfile.scenePreferences[scene] = current
  }

  /**
   * 更新风格偏好
   */
  updateStylePreference(style) {
    if (!this.userProfile.stylePreferences) {
      this.userProfile.stylePreferences = {}
    }

    const current = this.userProfile.stylePreferences[style] || 0
    this.userProfile.stylePreferences[style] = current + 1
  }

  /**
   * 分析匹配质量
   */
  analyzeMatchQuality(results) {
    if (results.length === 0) return

    // 分析匹配层级分布
    const layerStats = {}
    results.forEach(result => {
      const layer = result.matchLayer || 'unknown'
      layerStats[layer] = (layerStats[layer] || 0) + 1
    })

    // 如果太多结果来自推荐层，可能需要调整搜索策略
    const recommendationRatio = (layerStats.recommended || 0) / results.length
    if (recommendationRatio > 0.7) {
      this.userProfile.searchStrategy = 'more_precise'
    } else if (recommendationRatio < 0.2) {
      this.userProfile.searchStrategy = 'more_broad'
    }

    // 学习用户对不同匹配质量的偏好
    const avgRelevance = results.reduce((sum, r) => sum + (r.relevanceScore || 0), 0) / results.length
    if (avgRelevance < 0.3) {
      this.userProfile.qualityThreshold = Math.max(0.1, this.userProfile.qualityThreshold - 0.05)
    } else if (avgRelevance > 0.7) {
      this.userProfile.qualityThreshold = Math.min(0.5, this.userProfile.qualityThreshold + 0.02)
    }
  }

  /**
   * 生成个性化推荐
   */
  generatePersonalizedRecommendations(limit = 10) {
    const recommendations = []

    // 基于行业偏好推荐
    if (this.userProfile.industryPreferences) {
      const topIndustry = Object.entries(this.userProfile.industryPreferences)
        .sort(([, a], [, b]) => b.successRate - a.successRate)[0]?.[0]

      if (topIndustry) {
        const industryMaterials = Array.from(this.materials.values())
          .filter(m => m.industry === topIndustry)
          .sort((a, b) => (b.usageCount || 0) - (a.usageCount || 0))
          .slice(0, Math.floor(limit / 2))

        recommendations.push(...industryMaterials)
      }
    }

    // 基于场景偏好推荐
    if (this.userProfile.scenePreferences) {
      const topScene = Object.entries(this.userProfile.scenePreferences)
        .sort(([, a], [, b]) => b.successRate - a.successRate)[0]?.[0]

      if (topScene) {
        const sceneMaterials = Array.from(this.materials.values())
          .filter(m => m.scene === topScene)
          .slice(0, Math.floor(limit / 3))

        recommendations.push(...sceneMaterials)
      }
    }

    // 基于风格偏好推荐
    if (this.userProfile.stylePreferences) {
      const topStyle = Object.entries(this.userProfile.stylePreferences)
        .sort(([, a], [, b]) => b - a)[0]?.[0]

      if (topStyle) {
        const styleMaterials = Array.from(this.materials.values())
          .filter(m => m.style === topStyle)
          .slice(0, Math.floor(limit / 3))

        recommendations.push(...styleMaterials)
      }
    }

    // 去重并返回
    const seen = new Set()
    return recommendations.filter(m => {
      if (seen.has(m.id)) return false
      seen.add(m.id)
      return true
    }).slice(0, limit)
  }

  /**
   * 获取用户洞察
   */
  getUserInsights() {
    const insights = {
      topIndustries: [],
      topScenes: [],
      preferredStyles: [],
      searchPatterns: {},
      learningProgress: {}
    }

    // 行业偏好
    if (this.userProfile.industryPreferences) {
      insights.topIndustries = Object.entries(this.userProfile.industryPreferences)
        .sort(([, a], [, b]) => b.successRate - a.successRate)
        .slice(0, 3)
        .map(([industry, stats]) => ({ industry, ...stats }))
    }

    // 场景偏好
    if (this.userProfile.scenePreferences) {
      insights.topScenes = Object.entries(this.userProfile.scenePreferences)
        .sort(([, a], [, b]) => b.successRate - a.successRate)
        .slice(0, 3)
        .map(([scene, stats]) => ({ scene, ...stats }))
    }

    // 风格偏好
    if (this.userProfile.stylePreferences) {
      insights.preferredStyles = Object.entries(this.userProfile.stylePreferences)
        .sort(([, a], [, b]) => b - a)
        .slice(0, 3)
        .map(([style, count]) => ({ style, count }))
    }

    // 搜索模式分析
    insights.searchPatterns = this.analyzeSearchPatterns()

    return insights
  }

  /**
   * 分析搜索模式
   */
  analyzeSearchPatterns() {
    const patterns = {
      avgQueryLength: 0,
      commonKeywords: [],
      peakUsageHours: [],
      successRate: 0
    }

    if (this.userProfile.searchHistory.length === 0) return patterns

    // 平均查询长度
    const totalLength = this.userProfile.searchHistory.reduce((sum, h) => sum + h.query.length, 0)
    patterns.avgQueryLength = totalLength / this.userProfile.searchHistory.length

    // 常见关键词
    const keywordCount = {}
    this.userProfile.searchHistory.forEach(history => {
      const keywords = history.query.split(/[\s,，]+/).filter(k => k.length > 1)
      keywords.forEach(k => {
        keywordCount[k] = (keywordCount[k] || 0) + 1
      })
    })

    patterns.commonKeywords = Object.entries(keywordCount)
      .sort(([, a], [, b]) => b - a)
      .slice(0, 5)
      .map(([keyword, count]) => ({ keyword, count }))

    // 成功率
    const successfulSearches = this.userProfile.searchHistory.filter(h => h.resultCount > 0).length
    patterns.successRate = successfulSearches / this.userProfile.searchHistory.length

    return patterns
  }

  /**
   * 从存储获取数据
   */
  async getFromStore(storeName, key) {
    return new Promise((resolve, reject) => {
      const transaction = this.db.transaction([storeName], 'readonly')
      const store = transaction.objectStore(storeName)
      const request = store.get(key)

      request.onsuccess = () => resolve(request.result?.value)
      request.onerror = () => reject(request.error)
    })
  }

  /**
   * 保存数据到存储
   */
  async saveToStore(storeName, key, value) {
    return new Promise((resolve, reject) => {
      const transaction = this.db.transaction([storeName], 'readwrite')
      const store = transaction.objectStore(storeName)
      const request = store.put({ key, value, updatedAt: Date.now() })

      request.onsuccess = () => resolve()
      request.onerror = () => reject(request.error)
    })
  }

  // 数据库操作方法
  async getAllMaterials() {
    return new Promise((resolve, reject) => {
      const transaction = this.db.transaction(['materials'], 'readonly')
      const store = transaction.objectStore('materials')
      const request = store.getAll()

      request.onsuccess = () => resolve(request.result)
      request.onerror = () => reject(request.error)
    })
  }

  async addMaterialsBatch(materials) {
    return new Promise((resolve, reject) => {
      const transaction = this.db.transaction(['materials'], 'readwrite')
      const store = transaction.objectStore('materials')

      let completed = 0
      const total = materials.length

      materials.forEach(material => {
        const request = store.add(material)
        request.onsuccess = () => {
          this.materials.set(material.id, material)
          completed++
          if (completed === total) resolve()
        }
        request.onerror = () => reject(request.error)
      })
    })
  }

  async updateMaterial(material) {
    return new Promise((resolve, reject) => {
      const transaction = this.db.transaction(['materials'], 'readwrite')
      const store = transaction.objectStore('materials')
      const request = store.put(material)

      request.onsuccess = () => resolve()
      request.onerror = () => reject(request.error)
    })
  }

  /**
   * 启动渐进式加载
   */
  startProgressiveLoading() {
    // 1. 检查是否已加载必备包
    if (!this.loadingState.essential.loaded) {
      this.loadPackProgressive('essential')
    }

    // 2. 延迟加载增强包 (5分钟后)
    if (!this.loadingState.enhanced.loaded) {
      const timer = setTimeout(() => {
        this.loadPackProgressive('enhanced')
      }, 5 * 60 * 1000) // 5分钟
      this.loadingTimers.set('enhanced', timer)
    }

    // 3. 监听用户行为加载专业包
    this.observeUserBehavior()
  }

  /**
   * 渐进式加载素材包
   */
  async loadPackProgressive(packId) {
    if (this.loadingState[packId].loading || this.loadingState[packId].loaded) {
      return
    }

    this.loadingState[packId].loading = true
    console.log(`📦 开始加载${this.materialPacks[packId].name}...`)

    try {
      const pack = this.materialPacks[packId]
      const materials = await this.generatePackMaterials(packId)

      // 分批存储以避免阻塞UI
      const batchSize = 20
      for (let i = 0; i < materials.length; i += batchSize) {
        const batch = materials.slice(i, i + batchSize)
        await this.addMaterialsBatch(batch)

        // 每批处理后让出控制权
        await new Promise(resolve => setTimeout(resolve, 10))
      }

      // 更新索引
      await this.buildIndexes()

      this.loadingState[packId].loaded = true
      this.loadingState[packId].loading = false

      console.log(`✅ ${pack.name}加载完成，新增 ${materials.length} 个素材`)

      // 通知加载完成
      this.emitPackLoaded(packId)

    } catch (error) {
      console.error(`❌ ${this.materialPacks[packId].name}加载失败:`, error)
      this.loadingState[packId].loading = false
    }
  }

  /**
   * 生成指定包的素材
   */
  async generatePackMaterials(packId) {
    const pack = this.materialPacks[packId]
    const materials = []

    for (const category of pack.categories) {
      switch (category) {
        case 'icons':
          materials.push(...this.generateIconMaterials())
          break
        case 'charts':
          materials.push(...this.generateChartMaterials())
          break
        case 'education':
          materials.push(...this.generateEducationMaterials())
          break
        case 'tech':
          materials.push(...this.generateTechMaterials())
          break
        case 'business':
          materials.push(...this.generateBusinessMaterials())
          break
        case 'backgrounds':
          materials.push(...this.generateBackgroundMaterials())
          break
        case 'lifestyle':
          materials.push(...this.generateLifestyleMaterials())
          break
        case 'decorative':
          materials.push(...this.generateDecorativeMaterials())
          break
      }
    }

    return materials
  }

  /**
   * 观察用户行为
   */
  observeUserBehavior() {
    // 监听搜索行为
    this.searchBehaviorObserver = (query, results) => {
      this.onSearchBehavior(query, results)
    }

    // 监听使用行为
    this.usageBehaviorObserver = (materialId) => {
      this.onUsageBehavior(materialId)
    }
  }

  /**
   * 处理搜索行为
   */
  onSearchBehavior(query, results) {
    const keywords = query.split(/[\s,，]+/).filter(k => k.length > 0)

    // 检查是否需要专业包
    const needsProfessional = this.checkNeedsProfessionalPack(keywords, results)
    if (needsProfessional && !this.loadingState.professional.loaded && !this.loadingState.professional.loading) {
      // 清除延迟加载定时器
      const timer = this.loadingTimers.get('enhanced')
      if (timer) {
        clearTimeout(timer)
        this.loadingTimers.delete('enhanced')
      }

      // 立即加载专业包
      this.loadPackProgressive('professional')
    }
  }

  /**
   * 处理使用行为
   */
  onUsageBehavior(materialId) {
    const material = this.materials.get(materialId)
    if (!material) return

    // 更新用户偏好
    if (!this.userProfile.favoriteCategories.includes(material.category)) {
      this.userProfile.favoriteCategories.push(material.category)
      this.saveUserPreferences()
    }
  }

  /**
   * 检查是否需要专业包
   */
  checkNeedsProfessionalPack(keywords, results) {
    // 如果搜索结果很少，可能需要更丰富的素材
    if (results.length < 3) {
      return true
    }

    // 如果搜索特定领域关键词
    const professionalKeywords = ['艺术', '创意', '设计', '品牌', '营销', '生活方式']
    return keywords.some(keyword =>
      professionalKeywords.some(prof => keyword.includes(prof))
    )
  }

  /**
   * 发送包加载完成事件
   */
  emitPackLoaded(packId) {
    // 在浏览器环境中触发自定义事件
    if (typeof window !== 'undefined' && window.dispatchEvent) {
      const event = new CustomEvent('materialPackLoaded', {
        detail: { packId, pack: this.materialPacks[packId] }
      })
      window.dispatchEvent(event)
    }
  }

  /**
   * 获取加载状态
   */
  getLoadingState() {
    return {
      ...this.loadingState,
      totalLoaded: Object.values(this.loadingState).filter(state => state.loaded).length,
      totalPacks: Object.keys(this.loadingState).length
    }
  }

  /**
   * 强制加载指定包
   */
  async forceLoadPack(packId) {
    if (this.loadingTimers.has(packId)) {
      clearTimeout(this.loadingTimers.get(packId))
      this.loadingTimers.delete(packId)
    }
    await this.loadPackProgressive(packId)
  }

  // ===== 外部素材缓存管理方法 =====

  /**
   * 添加外部素材到缓存
   * 实现智能缓存策略：优先缓存百度图片，控制存储大小
   */
  async addExternalMaterial(material, source = 'unknown') {
    try {
      // 检查是否应该缓存
      if (!this.cacheManager.shouldCache(material, source)) {
        console.log(`🚫 跳过缓存素材 ${material.id} (来源: ${source})`)
        return false
      }

      // 计算素材大小
      const materialSize = this.cacheManager.estimateMaterialSize(material)

      // 检查存储空间（如果空间不足，先清理）
      if (this.cacheManager.currentCacheSize + materialSize > this.cacheManager.maxCacheSize) {
        const toRemove = this.cacheManager.cleanupExpiredCache(
          this.cacheManager.maxCacheSize * 0.7 // 清理到70%的容量
        )

        if (toRemove.length > 0) {
          console.log(`🧹 清理 ${toRemove.length} 个过期缓存，释放空间`)
          await this.removeExternalMaterials(toRemove)
        }
      }

      // 添加缓存记录
      this.cacheManager.addCacheRecord(material.id, source, materialSize)

      // 转换为缓存格式
      const cacheItem = {
        id: material.id,
        source: source,
        material: material,
        size: materialSize,
        cachedAt: Date.now(),
        lastAccess: Date.now(),
        usageCount: 1,
        priority: this.cacheManager.cachePriority[source] || 1
      }

      // 保存到IndexedDB
      await this.saveToStore('externalCache', material.id, cacheItem)

      // 同时保存到内存缓存
      this.materials.set(material.id, material)

      console.log(`💾 缓存外部素材: ${material.id} (${source}) - ${(materialSize / 1024 / 1024).toFixed(2)}MB`)
      return true
    } catch (error) {
      console.error('添加外部素材缓存失败:', error)
      return false
    }
  }

  /**
   * 获取缓存的外部素材
   */
  async getExternalMaterial(materialId) {
    try {
      const cacheItem = await this.getFromStore('externalCache', materialId)

      if (cacheItem) {
        // 更新访问记录
        cacheItem.lastAccess = Date.now()
        cacheItem.usageCount = (cacheItem.usageCount || 0) + 1

        // 更新缓存管理器
        this.cacheManager.usageCount.set(materialId, cacheItem.usageCount)
        this.cacheManager.accessLog.set(materialId, cacheItem.lastAccess)

        // 保存更新
        await this.saveToStore('externalCache', materialId, cacheItem)

        return cacheItem.material
      }

      return null
    } catch (error) {
      console.error('获取外部素材缓存失败:', error)
      return null
    }
  }

  /**
   * 批量移除外部素材缓存
   */
  async removeExternalMaterials(materialIds) {
    try {
      const transaction = this.db.transaction(['externalCache'], 'readwrite')
      const store = transaction.objectStore('externalCache')

      for (const materialId of materialIds) {
        await new Promise((resolve, reject) => {
          const request = store.delete(materialId)
          request.onsuccess = () => resolve()
          request.onerror = () => reject(request.error)
        })

        // 从内存中移除
        this.materials.delete(materialId)

        // 从缓存管理器中移除
        this.cacheManager.removeCacheRecord(materialId, 0) // 大小已在cleanup中处理
      }

      console.log(`🗑️ 移除 ${materialIds.length} 个外部素材缓存`)
    } catch (error) {
      console.error('批量移除外部素材缓存失败:', error)
    }
  }

  /**
   * 获取缓存统计信息
   */
  async getCacheStatistics() {
    const cacheStats = this.cacheManager.getCacheStats()

    try {
      // 从数据库获取实际的缓存项目数量
      const allCache = await this.getAllFromStore('externalCache')
      cacheStats.actualItems = allCache.length

      // 按平台统计
      const platformStats = {}
      allCache.forEach(item => {
        platformStats[item.source] = (platformStats[item.source] || 0) + 1
      })
      cacheStats.platformBreakdown = platformStats

    } catch (error) {
      console.error('获取缓存统计失败:', error)
    }

    return cacheStats
  }

  /**
   * 清理过期缓存
   */
  async cleanupExpiredCache() {
    const toRemove = this.cacheManager.cleanupExpiredCache()
    if (toRemove.length > 0) {
      await this.removeExternalMaterials(toRemove)
      console.log(`🧹 自动清理 ${toRemove.length} 个过期缓存`)
    }
    return toRemove.length
  }

  /**
   * 初始化缓存管理器状态
   * 从数据库加载现有缓存记录
   */
  async initializeCacheManager() {
    try {
      const allCache = await this.getAllFromStore('externalCache')

      for (const cacheItem of allCache) {
        this.cacheManager.addCacheRecord(
          cacheItem.id,
          cacheItem.source,
          cacheItem.size
        )

        // 更新访问和使用记录
        if (cacheItem.lastAccess) {
          this.cacheManager.accessLog.set(cacheItem.id, cacheItem.lastAccess)
        }
        if (cacheItem.usageCount) {
          this.cacheManager.usageCount.set(cacheItem.id, cacheItem.usageCount)
        }
      }

      console.log(`📊 缓存管理器初始化完成: ${allCache.length} 个缓存项目`)
    } catch (error) {
      console.error('初始化缓存管理器失败:', error)
    }
  }
}

// 导出单例实例
export default new LocalMaterialLibrary()
