  /**
   * 生成海边场景素材
   */
  generateBeachScene() {
    const scenes = [
      {
        id: 'beach-sunset',
        name: '海边日落',
        subcategory: '风景',
        industry: '生活',
        scene: '展示',
        style: '写实',
        type: 'svg',
        semanticTags: ['海边', '日落', '风景', '自然'],
        relatedConcepts: ['度假', '宁静', '美丽', '自然'],
        contextKeywords: ['海边', '日落', '风景'],
        dataUrl: this.generateBeachSunsetSvg(),
        thumbnailUrl: this.generateBeachSunsetSvg(),
        dimensions: { width: 600, height: 400 }
      },
      {
        id: 'beach-tropical',
        name: '热带海滩',
        subcategory: '风景',
        industry: '生活',
        scene: '展示',
        style: '明亮',
        type: 'svg',
        semanticTags: ['海滩', '热带', '椰子树', '度假'],
        relatedConcepts: ['假期', '放松', '阳光', '海水'],
        contextKeywords: ['海滩', '热带', '椰子树'],
        dataUrl: this.generateBeachTropicalSvg(),
        thumbnailUrl: this.generateBeachTropicalSvg(),
        dimensions: { width: 600, height: 400 }
      },
      {
        id: 'beach-storm',
        name: '海边风暴',
        subcategory: '风景',
        industry: '生活',
        scene: '展示',
        style: '戏剧性',
        type: 'svg',
        semanticTags: ['海边', '风暴', '波涛', '力量'],
        relatedConcepts: ['力量', '激情', '变化', '自然之力'],
        contextKeywords: ['风暴', '波涛', '力量'],
        dataUrl: this.generateBeachStormSvg(),
        thumbnailUrl: this.generateBeachStormSvg(),
        dimensions: { width: 600, height: 400 }
      }
    ];

    return scenes;
  }

  /**
   * 生成海边日落SVG
   */
  generateBeachSunsetSvg() {
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
      <!-- 天空渐变 -->
      <defs>
        <linearGradient id="skyGradient" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" style="stop-color:#FF6B35"/>
          <stop offset="30%" style="stop-color:#F7931E"/>
          <stop offset="70%" style="stop-color:#FFD23F"/>
          <stop offset="100%" style="stop-color:#87CEEB"/>
        </linearGradient>

        <!-- 海水渐变 -->
        <linearGradient id="oceanGradient" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" style="stop-color:#1E90FF"/>
          <stop offset="50%" style="stop-color:#4169E1"/>
          <stop offset="100%" style="stop-color:#000080"/>
        </linearGradient>

        <!-- 沙滩渐变 -->
        <linearGradient id="sandGradient" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" style="stop-color:#F4E4BC"/>
          <stop offset="100%" style="stop-color:#D2B48C"/>
        </linearGradient>
      </defs>

      <!-- 天空 -->
      <rect width="600" height="250" fill="url(#skyGradient)"/>

      <!-- 太阳 -->
      <circle cx="150" cy="120" r="35" fill="#FFD23F" opacity="0.8"/>
      <circle cx="150" cy="120" r="25" fill="#FFA500"/>
      <circle cx="150" cy="120" r="15" fill="#FF8C00"/>

      <!-- 云朵 -->
      <circle cx="100" cy="80" r="15" fill="rgba(255,255,255,0.6)"/>
      <circle cx="115" cy="75" r="18" fill="rgba(255,255,255,0.6)"/>
      <circle cx="130" cy="80" r="15" fill="rgba(255,255,255,0.6)"/>

      <circle cx="400" cy="60" r="12" fill="rgba(255,255,255,0.5)"/>
      <circle cx="415" cy="58" r="15" fill="rgba(255,255,255,0.5)"/>
      <circle cx="430" cy="60" r="12" fill="rgba(255,255,255,0.5)"/>

      <!-- 海面 -->
      <rect x="0" y="250" width="600" height="100" fill="url(#oceanGradient)"/>

      <!-- 海浪 -->
      <path d="M0 280 Q100 260 200 280 T400 280 Q500 300 600 280 L600 350 L0 350 Z" fill="#4682B4" opacity="0.7"/>
      <path d="M0 300 Q120 285 240 300 T480 300 Q550 315 600 300 L600 350 L0 350 Z" fill="#5F9EA0" opacity="0.5"/>
      <path d="M0 320 Q150 310 300 320 T600 320 L600 350 L0 350 Z" fill="#87CEEB" opacity="0.3"/>

      <!-- 沙滩 -->
      <rect x="0" y="350" width="600" height="50" fill="url(#sandGradient)"/>

      <!-- 贝壳 -->
      <ellipse cx="80" cy="370" rx="8" ry="4" fill="#FFE4B5" opacity="0.8"/>
      <ellipse cx="85" cy="372" rx="6" ry="3" fill="#DEB887" opacity="0.9"/>

      <ellipse cx="520" cy="375" rx="10" ry="5" fill="#FFE4B5" opacity="0.7"/>
      <ellipse cx="525" cy="377" rx="7" ry="3.5" fill="#DEB887" opacity="0.8"/>

      <!-- 椰子树 -->
      <rect x="480" y="320" width="8" height="30" fill="#8B4513"/>
      <circle cx="484" cy="315" r="25" fill="#228B22"/>
      <circle cx="484" cy="305" r="20" fill="#32CD32"/>
      <circle cx="475" cy="310" r="15" fill="#228B22"/>
      <circle cx="493" cy="310" r="15" fill="#228B22"/>

      <!-- 椰子 -->
      <circle cx="484" cy="325" r="4" fill="#8B4513"/>
      <circle cx="475" cy="320" r="3" fill="#654321"/>
      <circle cx="493" cy="318" r="3.5" fill="#654321"/>
    </svg>`;

    return `data:image/svg+xml;base64,${btoa(svg)}`;
  }

  /**
   * 生成热带海滩SVG
   */
  generateBeachTropicalSvg() {
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
      <!-- 天空 -->
      <rect width="600" height="200" fill="#87CEEB"/>
      <circle cx="450" cy="80" r="40" fill="#FFD700" opacity="0.9"/>
      <circle cx="450" cy="80" r="30" fill="#FFA500"/>

      <!-- 云朵 -->
      <circle cx="100" cy="60" r="20" fill="rgba(255,255,255,0.8)"/>
      <circle cx="120" cy="55" r="25" fill="rgba(255,255,255,0.8)"/>
      <circle cx="140" cy="60" r="20" fill="rgba(255,255,255,0.8)"/>
      <circle cx="160" cy="65" r="15" fill="rgba(255,255,255,0.8)"/>

      <circle cx="300" cy="70" r="18" fill="rgba(255,255,255,0.7)"/>
