  "autoBackup": {
    "enabled": true,
    "interval": "30m",
    "retention": "30d",
    "backupDir": ".ui-backups",
    "maxBackupsPerFile": 10
  },
  "changeDetection": {
    "enabled": true,
    "ignorePatterns": [
      "node_modules/**",
      ".git/**",
      "*.log",
      ".DS_Store",
      "dist/**",
      "*.test.js",
      "*.spec.js"
    ],
    "strictMode": true
  },
  "uiValidationRules": {
    "vueFiles": {
      "mustHaveTemplate": true,
      "mustHaveScript": true,
      "mustHaveStyle": false,
      "forbiddenPatterns": [
        "console.log",
        "debugger"
      ]
    },
    "cssFiles": {
      "mustHaveValidSyntax": true,
      "maxLineLength": 120,
      "mustUseDesignTokens": true
    },
    "jsFiles": {
      "mustHaveValidSyntax": true,
      "mustUseImports": true,
      "forbiddenGlobals": [
        "var",
        "eval"
      ]
    }
  }
