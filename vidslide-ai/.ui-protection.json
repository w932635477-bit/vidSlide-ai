{
  "protectedFiles": [
    "src/views/HomeView.vue",
    "src/views/VideoEditorView.vue",
    "src/views/WorkspaceView.vue"
  ],
  "uiIntegrityChecks": {
    "VideoEditorView.vue": {
      "criticalElements": [
        "title-bar",
        "workspace",
        "toolbar",
        "main-canvas",
        "properties-panel",
        "timeline"
      ],
      "requiredClasses": [
        ".title-bar",
        ".workspace",
        ".toolbar",
        ".main-canvas",
        ".properties-panel",
        ".timeline"
      ]
    },
    "WorkspaceView.vue": {
      "criticalElements": [
        "workspace",
        "workspace-header",
        "workspace-main",
        "left-panel",
        "main-editor",
        "right-panel",
        "timeline"
      ],
      "requiredClasses": [
        ".workspace",
        ".workspace-header",
        ".workspace-main",
        ".left-panel",
        ".main-editor",
        ".right-panel",
        ".timeline",
        ".header-content",
        ".workspace-title",
        ".header-actions",
        ".header-btn",
        ".panel-section",
        ".panel-title",
        ".template-list",
        ".template-btn",
        ".control-group",
        ".control-label",
        ".control-select",
        ".upload-area",
        ".upload-content",
        ".upload-title",
        ".upload-btn",
        ".editor-canvas",
        ".preview-video",
        ".status-list",
        ".status-item",
        ".animation-list",
        ".animation-btn",
        ".ai-list",
        ".ai-item",
        ".timeline-track",
        ".timeline-progress",
        ".timeline-controls",
        ".timeline-btn"
      ],
      "requiredContent": [
        "<main class=\"workspace-main\">",
        "<header class=\"workspace-header\">",
        "<aside class=\"left-panel\">",
        "<section class=\"main-editor\">",
        "<aside class=\"right-panel\">",
        "<footer class=\"timeline\">"
      ],
      "forbiddenPatterns": [
        "console.log",
        "debugger"
      ]
    }
  },
  "autoBackup": {
    "enabled": true,
    "interval": "30m",
    "retention": "30d"
  },
  "strictMode": {
    "enabled": true,
    "blockUnauthorizedChanges": true,
    "requireApprovalForModifications": true
  }
}